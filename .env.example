# Zkopírujte jako .env.local (do gitu nepůjde) a doplňte.
# Klíč: elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=

# Hlas pro všechny postavy (Voice ID z knihovny hlasů ElevenLabs) …
ELEVENLABS_VOICE=
# … nebo zvlášť pro každou postavu (přebije ELEVENLABS_VOICE)
ELEVENLABS_VOICE_NARRATOR=
ELEVENLABS_VOICE_HEDGEHOG=
ELEVENLABS_VOICE_BEE=
ELEVENLABS_VOICE_BUTTERFLY=
ELEVENLABS_VOICE_SQUIRREL=
ELEVENLABS_VOICE_FROG=
# kolo 4 – bez vlastního hlasu: krtek = ježek, žížala = motýl, brouček = včelka
ELEVENLABS_VOICE_MOLE=
ELEVENLABS_VOICE_WORM=
ELEVENLABS_VOICE_BEETLE=
